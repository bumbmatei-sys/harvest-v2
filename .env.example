DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Ordered, comma-separated headers overwritten by your ingress (default: x-forwarded-for).
AUTH_IP_ADDRESS_HEADERS=x-forwarded-for
# Exact proxy IPs/CIDRs for multi-hop headers; leave empty for single-value headers.
AUTH_TRUSTED_PROXIES=
RESEND_API_KEY=
EMAIL_FROM=
DODO_PAYMENTS_API_KEY=
NEON_API_KEY=
NEON_PROJECT_ID=

# Existing S3-compatible storage only. Provisioning is outside this PR.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Private files require a clean malware scan when true (default false).
FILES_REQUIRE_SCAN_PRIVATE=false

# HC-05 local synthetic tests only. Production is hard-disabled regardless of flag.
# Requires localhost harvest_test[_...] database and a disposable 64-hex test key.
# Leave both empty for normal development/production. Never use for real contacts.
HARVEST_CONNECT_INTAKE=
HARVEST_CONNECT_TEST_KEY=

# Optional local mock invitation operator output; never a live email transport.
HARVEST_CONNECT_TEST_MAILBOX=
