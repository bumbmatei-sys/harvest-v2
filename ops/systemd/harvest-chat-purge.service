[Unit]
Description=Harvest non-production chat retention sweep

[Service]
Type=oneshot
User=harvest
WorkingDirectory=/srv/harvest
EnvironmentFile=/etc/harvest/chat-purge.env
ExecStart=/usr/bin/npm run communities:purge-chat
TimeoutStartSec=1h
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=harvest-chat-purge
