import { createPool } from "./src/db/pool";
import { POST as auth } from "./src/app/api/auth/[...all]/route";
import { GET as workspaces } from "./src/app/api/workspaces/route";

let shared: ReturnType<typeof createPool> | undefined;
export default {
  async fetch(request: Request, env: { DATABASE_URL: string }) {
    const path = new URL(request.url).pathname;
    if (path.startsWith("/api/auth/")) return auth(request);
    if (path === "/api/workspaces") return workspaces(request);
    const scoped = path === "/scoped";
    const pool = scoped ? createPool(env.DATABASE_URL, 1) : (shared ??= createPool(env.DATABASE_URL, 1));
    try {
      const { rows } = await pool.query("select current_user as role");
      return Response.json(rows[0]);
    } finally {
      if (scoped) await pool.end();
    }
  },
};
